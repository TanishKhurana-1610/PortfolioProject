-- Creating View to store data for future visualiations

CREATE VIEW dbo.PopulationPercentageVaccinated AS
SELECT
    cod.continent,
    cod.location,
    cod.date,
    cod.population,
    cov.new_vaccinations,
    SUM(TRY_CAST(cov.new_vaccinations AS BIGINT))
        OVER (
            PARTITION BY cod.location
            ORDER BY TRY_CONVERT(DATE, cod.date)
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS RollingPeopleVaccinated
FROM dbo.CovidDeaths AS cod
JOIN dbo.CovidVaccinations AS cov
    ON cod.location = cov.location
    AND cod.date = cov.date
WHERE cod.continent IS NOT NULL;
